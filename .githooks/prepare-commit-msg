#!/bin/sh
# Strip Cursor attribution trailers that may be injected into commit messages.
MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

TMP_FILE="$(mktemp 2>/dev/null || echo "${MSG_FILE}.tmp")"
grep -v -E '^Co-authored-by: Cursor <cursoragent@cursor\.com>$|^Made-with: Cursor$' "$MSG_FILE" > "$TMP_FILE" 2>/dev/null
if [ -f "$TMP_FILE" ]; then
  mv "$TMP_FILE" "$MSG_FILE"
fi
exit 0
